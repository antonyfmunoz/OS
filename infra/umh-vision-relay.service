[Unit]
Description=UMH Vision Relay — bridges Beast camera to cockpit viewers
After=network.target umh-mesh.service

[Service]
Type=simple
WorkingDirectory=/opt/OS
ExecStart=/usr/bin/python3 /opt/OS/umh/vision_relay.py
ExecStartPost=/bin/sh -c '/sbin/iptables -C INPUT -s 172.16.0.0/12 -p tcp --dport 8097 -j ACCEPT 2>/dev/null || /sbin/iptables -I INPUT 1 -s 172.16.0.0/12 -p tcp --dport 8097 -m comment --comment "vision-relay-from-docker" -j ACCEPT'
ExecStartPost=/bin/sh -c '/sbin/iptables -C INPUT -s 127.0.0.0/8 -p tcp --dport 8097 -j ACCEPT 2>/dev/null || /sbin/iptables -I INPUT 2 -s 127.0.0.0/8 -p tcp --dport 8097 -m comment --comment "vision-relay-from-localhost" -j ACCEPT'
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/OS

[Install]
WantedBy=multi-user.target
