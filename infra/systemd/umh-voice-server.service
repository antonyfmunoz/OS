# UMH voice server — STT/TTS WebSocket bridge (ws://:8096/voice).
# P4S-31D-1 closes the lifecycle gap: this seam was a hand-started host
# process; nginx proxies /api/umh/voice/ws -> 127.0.0.1:8096/voice, so an
# unmanaged voice_server means the entire cockpit voice path is silently dead.
#
# Host process on purpose (same precedent as the mesh server on :8094):
# audio WS + STT fallback don't belong in the Docker runtime containers.
#
# Install (unit and voice_server.py must ship together — Type=notify below
# requires the sd_notify code added in P4S-31D lane G):
#   cp /opt/OS/infra/systemd/umh-voice-server.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now umh-voice-server
#
# Health check (plain HTTP on the WS port, served by process_request hook):
#   curl -fsS http://127.0.0.1:8096/health
#   -> {"status":"ok","uptime_s":...,"stt_engine":"groq",
#       "tts_provider":"kokoro","active_sessions":0}
# Compose-style equivalent (if this ever moves into a container):
#   healthcheck:
#     test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8096/health"]
#     interval: 30s
#     timeout: 5s
#     retries: 3
#
# Watchdog: Type=notify + WatchdogSec. voice_server.py speaks the sd_notify
# datagram protocol directly (READY=1 on listen, WATCHDOG=1 keepalive at half
# this interval from the event loop) — a hung event loop stops keepalives and
# systemd kills + restarts the unit. Restart=on-failure covers crashes and
# watchdog kills; a graceful SIGTERM stop exits 0 and is NOT restarted.
# StartLimit* bounds a crash loop (e.g. missing websockets dep at boot).
#
# Logs: stdout/stderr go to journald, which is size-bounded by default
# (SystemMaxUse, typically 10% of /var). The server never logs transcript
# text at INFO+ (<=40-char previews at DEBUG only), so journald retention
# never accumulates conversation content.
#
# Resource profile (measured 2026-07-06 on the VPS):
#   Groq STT path (default): ~26 MB RSS, ~0% CPU idle — negligible.
#   faster-whisper fallback: +300-900 MB RSS (model load), 1-1.5 core bursts
#   during transcription. CPUQuota=150% / MemoryMax=1G bound exactly that
#   worst case — do not raise without re-measuring.
#
# Secrets: voice_server.py loads /opt/OS/services/.env itself (same 1Password
# op-injected file the compose stack uses) — no plaintext values here.

[Unit]
Description=UMH voice server (STT/TTS WS bridge on :8096)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=/opt/OS
ExecStart=/usr/bin/python3 /opt/OS/umh/voice_server.py
Restart=on-failure
RestartSec=5
WatchdogSec=60
Environment=PYTHONUNBUFFERED=1
Environment=UMH_ROOT=/opt/OS
# CPU Gate Law: the local faster-whisper STT fallback is CPU-heavy; cap it so
# a transcription burst can never saturate the host (Hostinger throttles).
Nice=10
CPUQuota=150%
MemoryMax=1G

[Install]
WantedBy=multi-user.target
