{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.umh.dev/foundation/databases/record.v1.schema.json","title":"DatabaseRecord","description":"Canonical user-configurable database record.","type":"object","additionalProperties":false,"required":["id","objectType","schema_version","database_id","table_id","record_version","values","status","created_by","created_at","updated_at","version"],"properties":{"id":{"type":"string","minLength":1},"objectType":{"const":"Record"},"schema_version":{"const":"1.0.0"},"database_id":{"type":"string","minLength":1},"table_id":{"type":"string","minLength":1},"record_version":{"type":"integer","minimum":1},"values":{"type":"array","items":{"$ref":"https://schemas.umh.dev/foundation/databases/field-value.v1.schema.json"}},"status":{"type":"string","enum":["active","archived","deleted"]},"created_by":{"$ref":"https://schemas.umh.dev/foundation/envelopes/actor-ref.v1.schema.json"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"provenance":{"type":"object","additionalProperties":true},"authority_scope":{"type":"object","additionalProperties":true},"version":{"type":"integer","minimum":1},"extensions":{"type":"object","propertyNames":{"pattern":"^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\.v[0-9]+$"},"additionalProperties":true}},"x-umh":{"contractName":"DatabaseRecord","canonicalName":"Record","contractVersion":"1.0.0","domain":"databases","compatibility":"minor-additive"}}
