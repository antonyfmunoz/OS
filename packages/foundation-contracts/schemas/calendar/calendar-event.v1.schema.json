{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.umh.dev/foundation/calendar/event.v1.schema.json","title":"CalendarEvent","description":"Canonical scheduled event occurrence or series anchor.","type":"object","additionalProperties":false,"required":["id","objectType","schema_version","calendar_ref","title","status","start_at","end_at","timezone","participants","created_at","updated_at","version"],"properties":{"id":{"type":"string","minLength":1},"objectType":{"const":"Event"},"schema_version":{"const":"1.0.0"},"calendar_ref":{"$ref":"https://schemas.umh.dev/foundation/envelopes/object-ref.v1.schema.json"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["tentative","confirmed","canceled"]},"start_at":{"type":"string","format":"date-time"},"end_at":{"type":"string","format":"date-time"},"timezone":{"type":"string","minLength":1},"participants":{"type":"array","items":{"$ref":"https://schemas.umh.dev/foundation/calendar/participant.v1.schema.json"}},"recurrence_rule":{"$ref":"https://schemas.umh.dev/foundation/calendar/recurrence-rule.v1.schema.json"},"reservation_ref":{"$ref":"https://schemas.umh.dev/foundation/envelopes/object-ref.v1.schema.json"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"version":{"type":"integer","minimum":1},"extensions":{"type":"object","propertyNames":{"pattern":"^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\.v[0-9]+$"},"additionalProperties":true}},"x-umh":{"contractName":"CalendarEvent","canonicalName":"Event","contractVersion":"1.0.0","domain":"calendar","compatibility":"minor-additive","stateMachine":{"states":["tentative","confirmed","canceled"],"legalTransitions":[["tentative","confirmed"],["tentative","canceled"],["confirmed","canceled"]]}}}
