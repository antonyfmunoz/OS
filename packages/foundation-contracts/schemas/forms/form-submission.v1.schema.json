{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.umh.dev/foundation/forms/form-submission.v1.schema.json","title":"FormSubmission","description":"Immutable submitted form response preserving exact form version and validation outcome.","type":"object","additionalProperties":false,"required":["id","objectType","schema_version","form_ref","form_version","values","validation_status","submitted_at","version"],"properties":{"id":{"type":"string","minLength":1},"objectType":{"const":"FormSubmission"},"schema_version":{"const":"1.0.0"},"form_ref":{"$ref":"https://schemas.umh.dev/foundation/envelopes/object-ref.v1.schema.json"},"form_version":{"type":"integer","minimum":1},"submitter_ref":{"$ref":"https://schemas.umh.dev/foundation/envelopes/object-ref.v1.schema.json"},"values":{"type":"array","items":{"$ref":"https://schemas.umh.dev/foundation/forms/submission-value.v1.schema.json"}},"validation_status":{"type":"string","enum":["accepted","accepted_with_warnings","rejected"]},"validation_errors":{"type":"array","items":{"type":"string"}},"destination_record_ref":{"$ref":"https://schemas.umh.dev/foundation/envelopes/object-ref.v1.schema.json"},"submitted_at":{"type":"string","format":"date-time"},"evidence_refs":{"type":"array","items":{"$ref":"https://schemas.umh.dev/foundation/envelopes/evidence-ref.v1.schema.json"}},"version":{"type":"integer","minimum":1},"extensions":{"type":"object","propertyNames":{"pattern":"^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\.v[0-9]+$"},"additionalProperties":true}},"x-umh":{"contractName":"FormSubmission","contractVersion":"1.0.0","domain":"forms","compatibility":"minor-additive","historyRule":"submission-history-is-append-only-and-bound-to-exact-form-version"}}
