{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.umh.dev/foundation/files/restore-file-payload.v1.schema.json",
  "title": "RestoreFilePayload",
  "description": "Payload for RestoreFile.v1.",
  "type": "object",
