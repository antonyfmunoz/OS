  "required": ["file_ref", "restore_to_status", "reason"],
  "properties": {
    "file_ref": {"$ref": "https://schemas.umh.dev/foundation/envelopes/object-ref.v1.schema.json"},
    "restore_to_status": {"type": "string", "enum": ["ready", "archived"]},
    "reason": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "items": {"$ref": "https://schemas.umh.dev/foundation/envelopes/evidence-ref.v1.schema.json"}
    }
  },
  "x-umh": {"contractName": "RestoreFilePayload", "contractVersion": "1.0.0", "commandType": "RestoreFile.v1", "compatibility": "minor-additive"}
}
