{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.umh.dev/foundation/finance/invoice.v1.schema.json","title":"Invoice","description":"Canonical invoice document inside Finance core where supported by current contract surface.","type":"object","additionalProperties":false,"required":["id","objectType","schema_version","invoice_number","status","bill_to_ref","currency","total_amount","issued_at","due_at","version"],"properties":{"id":{"type":"string","minLength":1},"objectType":{"const":"Invoice"},"schema_version":{"const":"1.0.0"},"invoice_number":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","issued","paid","voided","overdue","written_off"]},"bill_to_ref":{"$ref":"https://schemas.umh.dev/foundation/envelopes/object-ref.v1.schema.json"},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"total_amount":{"type":"number","minimum":0},"issued_at":{"type":"string","format":"date-time"},"due_at":{"type":"string","format":"date-time"},"transaction_ref":{"$ref":"https://schemas.umh.dev/foundation/envelopes/object-ref.v1.schema.json"},"evidence_refs":{"type":"array","items":{"$ref":"https://schemas.umh.dev/foundation/envelopes/evidence-ref.v1.schema.json"}},"version":{"type":"integer","minimum":1},"extensions":{"type":"object","propertyNames":{"pattern":"^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\.v[0-9]+$"},"additionalProperties":true}},"x-umh":{"contractName":"Invoice","contractVersion":"1.0.0","domain":"finance","compatibility":"minor-additive","stateMachine":{"states":["draft","issued","paid","voided","overdue","written_off"],"legalTransitions":[["draft","issued"],["draft","voided"],["issued","paid"],["issued","overdue"],["issued","voided"],["overdue","paid"],["overdue","written_off"]]}}}
