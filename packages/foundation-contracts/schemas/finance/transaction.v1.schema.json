{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.umh.dev/foundation/finance/transaction.v1.schema.json","title":"Transaction","description":"Canonical financial transaction. Posted history is immutable; corrections are reversal, adjustment, or correcting entries.","type":"object","additionalProperties":false,"required":["id","objectType","schema_version","transaction_date","status","currency","lines","created_by","created_at","updated_at","version"],"properties":{"id":{"type":"string","minLength":1},"objectType":{"const":"Transaction"},"schema_version":{"const":"1.0.0"},"transaction_date":{"type":"string","format":"date-time"},"status":{"type":"string","enum":["draft","posted","voided","reversed","adjusted"]},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"lines":{"type":"array","minItems":2,"items":{"$ref":"https://schemas.umh.dev/foundation/finance/transaction-line.v1.schema.json"}},"correction_of_ref":{"$ref":"https://schemas.umh.dev/foundation/envelopes/object-ref.v1.schema.json"},"correction_type":{"type":"string","enum":["reversal","adjustment","correcting_entry"]},"memo":{"type":"string"},"created_by":{"$ref":"https://schemas.umh.dev/foundation/envelopes/actor-ref.v1.schema.json"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"posted_at":{"type":"string","format":"date-time"},"evidence_refs":{"type":"array","items":{"$ref":"https://schemas.umh.dev/foundation/envelopes/evidence-ref.v1.schema.json"}},"version":{"type":"integer","minimum":1},"extensions":{"type":"object","propertyNames":{"pattern":"^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\.v[0-9]+$"},"additionalProperties":true}},"x-umh":{"contractName":"Transaction","contractVersion":"1.0.0","domain":"finance","compatibility":"minor-additive","historyRule":"posted-transactions-are-immutable-corrections-append-new-evidence","stateMachine":{"states":["draft","posted","voided","reversed","adjusted"],"legalTransitions":[["d