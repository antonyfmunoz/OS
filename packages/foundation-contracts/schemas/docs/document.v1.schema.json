{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.umh.dev/foundation/docs/document.v1.schema.json","title":"Document","description":"Canonical authored document state. File storage belongs to Files.","type":"object","additionalProperties":false,"required":["id","objectType","schema_version","title","status","current_revision_id","owner_ref","created_by","created_at","updated_at","version"],"properties":{"id":{"type":"string","minLength":1},"objectType":{"const":"Document"},"schema_version":{"const":"1.0.0"},"title":{"type":"string","minLength":1},"status":{"type":"string","enum":["draft","in_review","approved","published","archived"]},"current_revision_id":{"type":"string","minLength":1},"owner_ref":{"$ref":"https://schemas.umh.dev/foundation/envelopes/object-ref.v1.schema.json"},"created_by":{"$ref":"https://schemas.umh.dev/foundation/envelopes/actor-ref.v1.schema.json"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"authority_scope":{"type":"object","additionalProperties":true},"provenance":{"type":"object","additionalProperties":true},"version":{"type":"integer","minimum":1},"extensions":{"type":"object","propertyNames":{"pattern":"^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\.v[0-9]+$"},"additionalProperties":true}},"x-umh":{"contractName":"Document","contractVersion":"1.0.0","domain":"docs","compatibility":"minor-additive","stateMachine":{"states":["draft","in_review","approved","published","archived"],"legalTransitions":[["draft","in_review"],["in_review","approved"],["in_review","draft"],["approved","published"],["published","archived"],["approved","archived"],["archived","draft"],["archived","published"]]}}}
