{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.umh.dev/foundation/identity/follow-up.v1.schema.json",
  "title": "FollowUp",
  "description": "Canonical relationship follow-up pointer. Actual work may bind to Task via task_ref.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "objectType", "schema_version", "relationship_id", "due_at", "status", "owner_actor_ref", "created_at", "updated_at", "version"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "objectType": {"const": "FollowUp"},
    "schema_version": {"const": "1.0.0"},
    "relationship_id": {"type": "string", "minLength": 1},
    "opportunity_id": {"type": "string"},
    "task_ref": {"$ref": "https://schemas.umh.dev/foundation/envelopes/object-ref.v1.schema.json"},
    "due_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["open", "completed", "canceled"]},
    "owner_actor_ref": {"$ref": "https://schemas.umh.dev/foundation/envelopes/actor-ref.v1.schema.json"},
    "reason": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  },
  "x-umh": {
    "contractName": "FollowUp",
    "contractVersion": "1.0.0",
    "domain": "identity",
    "compatibility": "minor-additive",
    "stateMachine": {
      "states": ["open", "completed", "canceled"],
      "terminalStates": ["completed", "canceled"],
      "legalTransitions": [["open", "completed"], ["open", "canceled"]]
    }
  }
}
