{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.umh.dev/foundation/identity/opportunity.v1.schema.json",
  "title": "Opportunity",
  "description": "Canonical opportunity associated with a Relationship and Pipeline/Stage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "objectType", "schema_version", "relationship_id", "pipeline_id", "stage_id", "name", "status", "source", "created_at", "updated_at", "version"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "objectType": {"const": "Opportunity"},
    "schema_version": {"const": "1.0.0"},
    "relationship_id": {"type": "string", "minLength": 1},
    "pipeline_id": {"type": "string", "minLength": 1},
    "stage_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["open", "won", "lost", "canceled"]},
    "amount": {"type": "number"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "expected_close_at": {"type": "string", "format": "date-time"},
    "owner_actor_ref": {"$ref": "https://schemas.umh.dev/foundation/envelopes/actor-ref.v1.schema.json"},
    "source": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\.v[0-9]+$"},
      "additionalProperties": true
    }
  },
  "x-umh": {
    "contractName": "Opportunity",
    "contractVersion": "1.0.0",
    "domain": "identity",
    "compatibility": "minor-additive",
    "stateMachine": {
      "states": ["open", "won", "lost", "canceled"],
      "terminalStates": ["won", "lost", "canceled"],
      "legalTransitions": [["open", "won"], ["open", "lost"], ["open", "canceled"]]
    }
  }
}
