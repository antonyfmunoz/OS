{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.umh.dev/foundation/identity/facet.v1.schema.json",
  "title": "Facet",
  "description": "Contextual role attached to a Relationship, not a Person subtype.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "objectType", "schema_version", "relationship_id", "facet_key", "status", "created_at", "updated_at", "version"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "objectType": {"const": "Facet"},
    "schema_version": {"const": "1.0.0"},
    "relationship_id": {"type": "string", "minLength": 1},
    "facet_key": {"type": "string", "enum": ["customer", "prospect", "employee", "candidate", "vendor", "investor", "audience", "sponsor", "affiliate", "collaborator", "friend", "family", "mentor"]},
    "status": {"type": "string", "enum": ["active", "inactive", "archived"]},
    "effective_from": {"type": "string", "format": "date-time"},
    "effective_to": {"type": "string", "format": "date-time"},
    "projection_namespace": {"type": "string"},
    "metadata": {"type": "object", "additionalProperties": true},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\.v[0-9]+$"},
      "additionalProperties": true
    }
  },
  "x-umh": {"contractName": "Facet", "contractVersion": "1.0.0", "domain": "identity", "compatibility": "minor-additive"}
}
