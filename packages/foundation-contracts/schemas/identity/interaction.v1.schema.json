{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.umh.dev/foundation/identity/interaction.v1.schema.json",
  "title": "Interaction",
  "description": "Immutable relationship interaction fact. Corrections append superseding events.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "objectType", "schema_version", "relationship_id", "interaction_type", "occurred_at", "created_at", "version"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "objectType": {"const": "Interaction"},
    "schema_version": {"const": "1.0.0"},
    "relationship_id": {"type": "string", "minLength": 1},
    "interaction_type": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "direction": {"type": "string", "enum": ["inbound", "outbound", "internal", "unknown"]},
    "channel": {"type": "string"},
    "summary": {"type": "string"},
    "source_object_refs": {
      "type": "array",
      "items": {"$ref": "https://schemas.umh.dev/foundation/envelopes/object-ref.v1.schema.json"}
    },
    "actor_ref": {"$ref": "https://schemas.umh.dev/foundation/envelopes/actor-ref.v1.schema.json"},
    "evidence_refs": {
      "type": "array",
      "items": {"$ref": "https://schemas.umh.dev/foundation/envelopes/evidence-ref.v1.schema.json"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*\\.v[0-9]+$"},
      "additionalProperties": true
    }
  },
  "x-umh": {"contractName": "Interaction", "contractVersion": "1.0.0", "domain": "identity", "compatibility": "minor-additive"}
}
