.env.local
.env.production

# 1Password templates — safe to commit (contain op:// references, not secrets)
!*.env.tpl
!.env.sessions.tpl
!.env.*.tpl

# LiveKit — resolved config with secrets (generated from livekit.yaml.tpl)
infra/livekit.yaml
!infra/livekit.yaml.tpl

# Non-secret config — safe to commit
# config/nonsecret.env is per-tenant instance data — NOT committed.
# Ship config/nonsecret.env.example (placeholders) instead.
config/nonsecret.env
!config/nonsecret.env.example

