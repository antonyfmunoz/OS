#!/bin/bash
# CPU-safe cron wrapper for UMH Python scripts.
#
# Usage: cron-run <script.py> [args...]
#
# Provides four layers of protection:
#   1. flock — prevents overlapping runs of the same script
#   2. nice/ionice — lowest scheduling priority
#   3. timeout — kills if running longer than 4 minutes (cron fires every 5)
#   4. CPU load gate — skips entirely if system is already overloaded
#
# Secret injection: if 1Password CLI is available and authenticated,
# secrets are injected via `op run`. Otherwise falls back to env vars
# already in the shell (e.g. from sourced .env files).
#
# Lock files live in /run/umh-cron/ (root-only tmpfs, not world-writable /tmp).

set -euo pipefail

SCRIPT="$1"
shift

LOCK_DIR="/run/umh-cron"
mkdir -p "$LOCK_DIR"
chmod 0700 "$LOCK_DIR"

LOCK_NAME=$(basename "$SCRIPT" .py)
LOCK_FILE="$LOCK_DIR/${LOCK_NAME}.lock"

# CPU load gate: skip if load per core > 2.0
CORES=$(nproc 2>/dev/null || echo 4)
LOAD=$(awk '{print $1}' /proc/loadavg 2>/dev/null || echo "0")
THRESHOLD=$(echo "$CORES * 2" | bc 2>/dev/null || echo "8")
if [ "$(echo "$LOAD > $THRESHOLD" | bc 2>/dev/null || echo 0)" -eq 1 ]; then
    echo "[cron-run] SKIPPED $LOCK_NAME — load=$LOAD > threshold=$THRESHOLD"
    exit 0
fi

# Build the command pipeline
CMD=(python3 "$SCRIPT" "$@")

# If 1Password CLI is available, wrap with op run for secret injection
UMH_ROOT="${UMH_ROOT:-/opt/OS}"
if command -v op &>/dev/null && [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
    CMD=(op run --env-file="$UMH_ROOT/services/.env.tpl" -- "${CMD[@]}")
fi

# flock -n = non-blocking; exits immediately if another instance holds the lock
exec flock -n "$LOCK_FILE" \
    nice -n 15 ionice -c 3 \
    timeout 240 \
    "${CMD[@]}"
