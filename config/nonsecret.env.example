# config/nonsecret.env.example — per-tenant non-secret config TEMPLATE.
# Copy to config/nonsecret.env (gitignored) and fill with YOUR instance's
# values. This file ships placeholders only — never a real tenant's data.
# Secrets live in 1Password (op://${UMH_OP_VAULT}/...), not here.

# UMH non-secret configuration — safe to commit
# Loaded by shell sessions: set -a; source config/nonsecret.env; set +a

# ── Identity ─────────────────────────────────────────────────────────────────
AI_NAME=
ANTHROPIC_DISABLE_TELEMETRY=false
TZ=UTC

# ── Infrastructure ───────────────────────────────────────────────────────────
OLLAMA_BASE_URL=
UMH_PUBLIC_DOMAIN=
UMH_DEV_BYPASS=false

# ── EOS Identity ─────────────────────────────────────────────────────────────
EOS_ORG_ID=
EOS_USER_ID=
EOS_PORTFOLIO_ID=

# ── Discord Channel IDs (public snowflake IDs) ──────────────────────────────
DISCORD_CHANNEL_CONTENT=
DISCORD_CHANNEL_DECISIONS=
DISCORD_CHANNEL_GENERAL=
DISCORD_CHANNEL_MORNING_BRIEF=
DISCORD_CHANNEL_OUTREACH=
DISCORD_CHANNEL_STRATEGY=
DISCORD_CHANNEL_WINS=
DISCORD_FOUNDERS_OFFICE=
FOUNDER_DISCORD_ID=
TELEGRAM_CHAT_ID=

# ── Instagram (username only — password in 1Password) ───────────────────────
INSTAGRAM_USERNAME=

# ── EOS Discord Router ──────────────────────────────────────────────────────
EOS_DISCORD_BUILDER_CHANNELS=
EOS_DISCORD_BUILDER_SESSION=assistant_main
EOS_DISCORD_BUILDER_TARGET=
EOS_DISCORD_PRODUCT_CHANNELS=
EOS_DISCORD_PRODUCT_SESSION=assistant_main
EOS_DISCORD_PRODUCT_TARGET=
EOS_DISCORD_TEXT_ALLOWED_CHANNELS=
EOS_DISCORD_TEXT_ALLOWED_GUILDS=
EOS_DISCORD_TEXT_ALLOWED_USERS=
EOS_DISCORD_TEXT_REPLY_TTS_ENABLED=false
EOS_DISCORD_TEXT_TRANSPORT_ENABLED=false

# ── Local Bridge (Beast PC via Tailscale) ───────────────────────────────────
EOS_LOCAL_BRIDGE_ENABLED=false
EOS_LOCAL_BRIDGE_IP=
EOS_LOCAL_BRIDGE_PORT=

# ── UMH Router ───────────────────────────────────────────────────────────────
UMH_ROUTER_CLAUDE_CLI_ENABLED=false
UMH_ROUTER_CLAUDE_CLI_SESSION=assistant_main
UMH_ROUTER_CLAUDE_CLI_TARGET=

# ── Notion Signal Sources ───────────────────────────────────────────────────
